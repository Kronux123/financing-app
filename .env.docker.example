# Copy to .env.docker (gitignored) and fill in the three blanks below.
#
#   APP_KEY           docker compose run --rm --entrypoint php app artisan key:generate --show
#   DB_PASSWORD       any strong value
#   POSTGRES_PASSWORD must be IDENTICAL to DB_PASSWORD
#
# Postgres reads POSTGRES_*; Laravel reads DB_*. They point at the same database, so the
# user/database/password pairs have to agree or the app authenticates against nothing.
# POSTGRES_* only takes effect on first boot -- changing it later does nothing until the
# pgdata volume is dropped with `docker compose down -v`.
#
# No MAIL_* here on purpose: locally the log driver is fine. In production it is not --
# everything past the landing page sits behind `verified`, so without real SMTP you
# register, never get the email, and lock yourself out.

APP_NAME=Kept
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kept
DB_USERNAME=kept
DB_PASSWORD=

POSTGRES_DB=kept
POSTGRES_USER=kept
POSTGRES_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

LARAVEL_PDF_DRIVER=chrome